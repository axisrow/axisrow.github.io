    <section id="projects" class="section section-projects">
      <div class="visual-field projects-field reveal">
        <div class="projects-field-visual" aria-hidden="true">
          <canvas id="projects-plasma" class="effect-canvas" data-effect="plasma"></canvas>
        </div>
        <div class="projects-field-copy veil-panel">
          <p class="eyebrow"><span>02</span> <span data-i18n="projects.eyebrow">Selected Work</span></p>
          <h2 class="section-title" data-i18n="projects.title">Systems with measurable output</h2>
          <p class="section-note"><span data-i18n="projects.notePrefix">Original repositories with the stars — see all at </span><a href="https://github.com/{{ handle }}?tab=repositories" target="_blank" rel="noopener">github.com/{{ handle }}</a>.</p>
        </div>
      </div>
      <div class="project-surface veil-panel">
      <div class="project-filter-bar" role="tablist" data-i18n-attr="aria-label:projects.filterLabel" aria-label="Filter projects by category">
        <button type="button" class="filter-pill is-active" data-filter="all" data-i18n="projects.filterAll">All</button>
        <button type="button" class="filter-pill" data-filter="integrations" data-i18n="projects.group.integrations">Integrations</button>
        <button type="button" class="filter-pill" data-filter="agent-tooling" data-i18n="projects.group.agent-tooling">Agent Tooling</button>
        <button type="button" class="filter-pill" data-filter="evaluation-data" data-i18n="projects.group.evaluation-data">Evaluation &amp; Data</button>
      </div>
{% for group, repos in projects.items() %}      <div class="project-group" data-category="{{ group | replace(' & ', '-') | replace(' / ', '-') | replace(' ', '-') | lower }}">
      <h3 class="group-title" data-i18n="projects.group.{{ group | replace(' & ', '-') | replace(' / ', '-') | replace(' ', '-') | lower }}">{{ group }}</h3>
      <div class="cards project-cards">
{% for name in repos %}        <a class="card reveal" href="https://github.com/{{ handle }}/{{ name }}" target="_blank" rel="noopener">
          <div class="card-head"><span class="card-name">{{ name }}</span>{% if stars[name] %}<span class="card-star">★ {{ stars[name] }}</span>{% endif %}</div>
          <p class="card-desc" data-i18n="projects.desc.{{ name }}">{{ descriptions[name] }}</p>
          <span class="card-link" data-i18n="projects.viewRepository">View repository ↗</span>
        </a>
{% endfor %}      </div>
{% for name in repos if cases_by_project[name] %}{% set case = cases_by_project[name] %}      <div class="case-study" id="case-{{ name }}">
        <div class="case-head">
          <span class="case-tag" data-i18n="projects.case.tag">Case study</span>
          <strong class="case-name">{{ name }}</strong>
        </div>
        <img class="case-figure" src="{{ case.image.src }}" width="{{ case.image.width }}" height="{{ case.image.height }}" alt="{{ case.image_alt }}" data-i18n-attr="alt:projects.case.{{ name }}.imageAlt" loading="lazy" decoding="async">
        <dl class="case-grid">
          <div><dt data-i18n="projects.case.taskLabel">The task</dt><dd data-i18n="projects.case.{{ name }}.task">{{ case.task }}</dd></div>
          <div><dt data-i18n="projects.case.builtLabel">What was built</dt><dd data-i18n="projects.case.{{ name }}.built">{{ case.built }}</dd></div>
          <div><dt data-i18n="projects.case.resultLabel">Verified result</dt><dd data-i18n="projects.case.{{ name }}.result">{{ case.result }}</dd></div>
        </dl>
        <p class="case-role"><span data-i18n="projects.case.roleLabel">Role</span> <span data-i18n="projects.case.{{ name }}.role">{{ case.role }}</span></p>
        <div class="case-links">
          <a class="case-link case-link-demo" href="{{ case.demo_url }}" target="_blank" rel="noopener" data-i18n="{{ case.demo_link_key }}">Try it ↗</a>
          <a class="case-link" href="https://github.com/{{ handle }}/{{ name }}" target="_blank" rel="noopener" data-i18n="projects.viewRepository">View repository ↗</a>
        </div>
      </div>
{% endfor %}      </div>
{% endfor %}      </div>
    </section>
